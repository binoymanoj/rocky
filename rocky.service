[Unit]
Description=Rocky AI Buddy
After=network.target ollama.service sound.target
Wants=ollama.service

[Service]
Type=simple
User=zoro
Group=audio
SupplementaryGroups=video audio
WorkingDirectory=/home/zoro/rocky
Environment="PATH=/home/zoro/rocky/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="JACK_NO_START_SERVER=1"
ExecStart=/home/zoro/rocky/venv/bin/python /home/zoro/rocky/app.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
